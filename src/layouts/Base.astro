---
import '../styles/global.css';
import { contact } from '../data/site';
import StickyCta from '../components/StickyCta.tsx';

interface Props {
  title: string;
  description: string;
  backHome?: boolean;
}

const { title, description, backHome = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#F7F2EA" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Karla:wght@400;500;600;700&display=swap"
  />
</head>
<body>
  <div class="wrap">
    <header class="flex items-baseline justify-between gap-4 pt-9">
      {backHome
        ? <a class="display text-[19px] font-semibold tracking-[-0.01em]" href={`${base}/`}>Массаж &amp; уход</a>
        : <div class="display text-[19px] font-semibold tracking-[-0.01em]">Массаж &amp; уход</div>}
      <a
        class="inline-block -my-2.5 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors duration-150 hover:text-[var(--ink)]"
        style="color: var(--ink-soft)"
        href={contact.tel}
      >{contact.phone}</a>
    </header>

    <slot />

    <div
      class="mt-[88px] flex flex-col gap-6 rounded-[20px] border px-9 py-14 max-[420px]:px-6 max-[420px]:py-9"
      style="background: var(--panel); color: var(--panel-text); border-color: var(--panel-rule)"
    >
      <div class="display text-[28px] font-semibold leading-[1.15] tracking-[-0.015em]">
        Записаться<br />на процедуру
      </div>
      <p class="max-w-[44ch] text-base" style="color: var(--panel-muted)">
        Приём в кабинете — Стамбул, Османбей. Также выезжаю на дом по городу.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href={contact.whatsapp} class="btn btn-primary">WhatsApp</a>
        <a
          href={contact.tel}
          class="btn btn-quiet"
          style="border-color: var(--panel-rule); color: var(--panel-text)"
        >{contact.phone}</a>
      </div>
    </div>

    <footer class="mt-9 flex flex-wrap items-baseline justify-between gap-2.5 text-[13px]" style="color: var(--ink-faint)">
      {backHome
        ? <a class="group inline-flex items-center gap-1.5 -my-3 py-3 text-[15px] font-semibold transition-colors duration-150 hover:text-[var(--ink)]" style="color: var(--ink-soft)" href={`${base}/`}>
            <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:-translate-x-0.5">←</span> Назад на главную
          </a>
        : <span>Стамбул · Османбей · выезд по городу</span>}
      <a class="inline-block -my-3 py-3" href={contact.tel}>{contact.phone}</a>
    </footer>
  </div>

  <StickyCta
    client:idle
    href={contact.whatsapp}
    label={backHome ? 'WhatsApp' : 'Написать в WhatsApp'}
    secondary={backHome ? { href: `${base}/`, label: 'На главную' } : undefined}
  />
</body>
</html>
