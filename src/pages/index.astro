---
import Base from '../layouts/Base.astro';
import Reveal from '../components/Reveal.tsx';
import ServiceIndex from '../components/ServiceIndex.tsx';
import { services, hardware, prices, contact } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const priceRows = [prices.salon, prices.home, prices.hardware];
---

<Base
  title="Массаж и уход — Стамбул, Османбей"
  description="Массаж и аппаратный уход за лицом и телом. Стамбул, Османбей — приём в кабинете и выезд на дом по городу."
>
  <div class="flex flex-col gap-6 pt-[88px]">
    <Reveal client:load>
      <div
        class="flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.16em] before:block before:h-px before:w-7 before:shrink-0 before:bg-[var(--rule-strong)] before:content-['']"
        style="color: var(--ink-faint)"
      >{contact.location}</div>
    </Reveal>

    <Reveal client:load delay={0.06}>
      <h1 class="display h1">Массаж и уход<br />за телом и лицом</h1>
    </Reveal>

    <Reveal client:load delay={0.12}>
      <p class="lede">
        Классические и антицеллюлитные техники, лимфодренаж, баночный и медовый массаж,
        аппаратный уход за лицом и телом. Принимаю в кабинете в Османбей или приезжаю к вам домой.
      </p>
    </Reveal>

    <Reveal client:load delay={0.18}>
      <div class="mt-2.5 flex flex-wrap items-center gap-4" data-cta-anchor>
        <a href={contact.whatsapp} class="btn btn-primary max-[420px]:w-full">Написать в WhatsApp</a>
        <a href={contact.tel} class="btn btn-quiet max-[420px]:w-full">Позвонить</a>
      </div>
    </Reveal>
  </div>

  <section class="movement">
    <div class="sec-head">
      <h2 class="h2">Виды массажа</h2>
      <span class="sec-meta">{services.length} техник</span>
    </div>
    <ServiceIndex client:visible items={services.map((s) => ({ slug: s.slug, short: s.short }))} base={base} />
  </section>

  <section class="movement">
    <div class="sec-head">
      <h2 class="h2">Аппаратный уход</h2>
      <span class="sec-meta">30 минут · 800 ₺</span>
    </div>
    <div class="grid grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] items-start gap-9 max-[640px]:grid-cols-1 max-[640px]:gap-6">
      <div>
        <ul class="flex list-none flex-col gap-2.5 p-0">
          {hardware.map((h) => (
            <li class="display text-xl font-semibold tracking-[-0.01em]">{h}</li>
          ))}
        </ul>
        <p class="mt-4 text-sm" style="color: var(--ink-faint)">
          Аппаратные процедуры провожу в кабинете в Османбей.
        </p>
      </div>
      <figure class="m-0">
        <div
          class="relative overflow-hidden rounded-[12px] after:absolute after:inset-0 after:bg-[#C08553] after:opacity-[0.12] after:mix-blend-multiply after:content-['']"
          style="background: var(--paper-raised)"
        >
          <img
            src={`${base}/img/apparatnyy-uhod.jpg`}
            width="891"
            height="1167"
            loading="lazy"
            decoding="async"
            class="block w-full [filter:saturate(0.85)_contrast(1.02)]"
            alt="Аппаратная процедура для лица в кабинете в Османбей"
          />
        </div>
        <figcaption class="mt-4 text-[13px] leading-[1.5]" style="color: var(--ink-faint)">
          Аппаратная процедура для лица.<br />Кабинет в Османбей.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="movement">
    <div class="sec-head">
      <h2 class="h2">Стоимость</h2>
      <span class="sec-meta">за сеанс</span>
    </div>
    <div class="flex flex-col">
      {priceRows.map((row, i) => (
        <div
          class:list={[
            'flex items-baseline justify-between gap-6 border-b border-[var(--rule)] last:border-b-0',
            i === 0 ? 'py-[22px]' : 'py-4',
          ]}
        >
          <div>
            <span class:list={['block font-semibold', i === 0 ? 'text-[18px]' : 'text-base']}>{row.name}</span>
            <span class="mt-0.5 block text-[13px]" style="color: var(--ink-faint)">{row.meta}</span>
          </div>
          <div
            class:list={[
              'display whitespace-nowrap font-semibold tabular-nums',
              i === 0 ? 'text-[30px] tracking-[-0.01em]' : 'text-[19px]',
            ]}
            style={i === 0 ? 'color: var(--accent)' : 'color: var(--ink-soft)'}
          >{row.value}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
