---
import Base from '../../layouts/Base.astro';
import Reveal from '../../components/Reveal.tsx';
import { services, prices, contact } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const priceRows = [
  { ...prices.salon, name: 'В кабинете' },
  { ...prices.home, name: 'С выездом на дом' },
];
---

<Base title={`${service.title} — Стамбул, Османбей`} description={service.description} backHome>
  <div class="flex flex-col gap-6 pt-[88px]">
    <Reveal client:load>
      <div
        class="flex items-center gap-2.5 text-xs font-bold uppercase tracking-[0.16em] before:block before:h-px before:w-7 before:shrink-0 before:bg-[var(--rule-strong)] before:content-['']"
        style="color: var(--ink-faint)"
      >Вид массажа</div>
    </Reveal>

    <Reveal client:load delay={0.06}>
      <h1 class="display h1">{service.title}</h1>
    </Reveal>

    <Reveal client:load delay={0.12}>
      <div class="mt-2.5 flex flex-wrap items-center gap-4" data-cta-anchor>
        <a href={contact.whatsapp} class="btn btn-primary max-[420px]:w-full">Записаться в WhatsApp</a>
      </div>
    </Reveal>
  </div>

  <section class="movement">
    <div class="sec-head"><h2 class="h2">Что это такое</h2></div>
    <Reveal client:visible><p class="lede">{service.about}</p></Reveal>
  </section>

  <section class="movement">
    <div class="sec-head"><h2 class="h2">Что вы получите</h2></div>
    <Reveal client:visible>
      <ul class="flex max-w-[58ch] list-none flex-col gap-4 p-0">
        {service.gains.map((gain) => (
          <li
            class="relative pl-[30px] before:absolute before:left-0 before:top-[0.72em] before:h-px before:w-4 before:bg-[var(--accent)] before:content-['']"
            style="color: var(--ink-soft)"
          >{gain}</li>
        ))}
      </ul>
    </Reveal>
  </section>

  <section class="movement">
    <div class="sec-head"><h2 class="h2">Кому подходит</h2></div>
    <Reveal client:visible><p class="body-text">{service.fit}</p></Reveal>
  </section>

  <section class="movement">
    <div class="sec-head">
      <h2 class="h2">Стоимость</h2>
      <span class="sec-meta">за сеанс</span>
    </div>
    <div class="flex flex-col">
      {priceRows.map((row, i) => (
        <div
          class:list={[
            'flex items-baseline justify-between gap-6 border-b border-[var(--rule)] last:border-b-0',
            i === 0 ? 'py-[22px]' : 'py-4',
          ]}
        >
          <div>
            <span class:list={['block font-semibold', i === 0 ? 'text-[18px]' : 'text-base']}>{row.name}</span>
            <span class="mt-0.5 block text-[13px]" style="color: var(--ink-faint)">{row.meta}</span>
          </div>
          <div
            class:list={[
              'display whitespace-nowrap font-semibold tabular-nums',
              i === 0 ? 'text-[30px] tracking-[-0.01em]' : 'text-[19px]',
            ]}
            style={i === 0 ? 'color: var(--accent)' : 'color: var(--ink-soft)'}
          >{row.value}</div>
        </div>
      ))}
    </div>
  </section>
</Base>
